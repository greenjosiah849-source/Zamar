<Window x:Class="ZamarPlayer.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zamar Player - Game" Height="900" Width="1440"
        Background="#0a0e27"
        WindowStyle="None"
        AllowsTransparency="True"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        MouseMove="Window_MouseMove"
        MouseDown="Window_MouseDown"
        MouseUp="Window_MouseUp"
        Closed="Window_Closed">
    
    <Grid>
        <!-- Main Game Viewport -->
        <Canvas x:Name="GameCanvas" Background="#0a0e27" />

        <!-- HUD Overlay -->
        <Grid Opacity="0.95" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="60" Background="#1a1f3a">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="{Binding GameName}" Foreground="#00D7FF" FontSize="18" FontWeight="Bold" Margin="0,0,30,0" />
                <TextBlock Text="Players:" Foreground="#FFFFFF" FontSize="12" Margin="0,0,10,0" />
                <TextBlock x:Name="PlayersCountText" Text="0" Foreground="#FF006E" FontSize="12" />
                <TextBlock Text="FPS:" Foreground="#FFFFFF" FontSize="12" Margin="30,0,10,0" />
                <TextBlock x:Name="FpsText" Text="60" Foreground="#00D7FF" FontSize="12" />
                <TextBlock Text="Ping:" Foreground="#FFFFFF" FontSize="12" Margin="30,0,10,0" />
                <TextBlock x:Name="PingText" Text="0ms" Foreground="#FF006E" FontSize="12" />
            </StackPanel>

            <Button Content="⚙" 
                    Style="{StaticResource NavButton}"
                    HorizontalAlignment="Right" 
                    Margin="0,0,20,0"
                    Width="40" Height="40"
                    Click="Settings_Click" />
        </Grid>

        <!-- Player HUD (Bottom Left) -->
        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20" Width="300">
            <!-- Player Health -->
            <StackPanel Orientation="Vertical" Margin="0,0,0,20">
                <TextBlock Text="Health" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" />
                <ProgressBar x:Name="HealthBar" Height="20" Background="#1a1f3a" Foreground="#00D7FF" 
                             Value="100" Maximum="100" />
                <TextBlock x:Name="HealthText" Text="100 / 100" Foreground="#00D7FF" FontSize="11" Margin="0,5,0,0" />
            </StackPanel>

            <!-- Player Stats -->
            <Grid VerticalAlignment="Bottom">
                <Border BorderBrush="#FF006E" BorderThickness="1" CornerRadius="5" Background="#1a1f3a" Padding="15">
                    <StackPanel Orientation="Vertical" Spacing="8">
                        <TextBlock Text="Statistics" Foreground="#00D7FF" FontSize="12" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Score:" Foreground="#FFFFFF" FontSize="11" />
                            <TextBlock x:Name="ScoreText" Text="0" Foreground="#FF006E" FontSize="11" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Kills:" Foreground="#FFFFFF" FontSize="11" />
                            <TextBlock x:Name="KillsText" Text="0" Foreground="#00D7FF" FontSize="11" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Deaths:" Foreground="#FFFFFF" FontSize="11" />
                            <TextBlock x:Name="DeathsText" Text="0" Foreground="#FF006E" FontSize="11" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Players List (Top Right) -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Right" Margin="20" Width="250">
            <Border BorderBrush="#FF006E" BorderThickness="1" CornerRadius="5" Background="#1a1f3a" Padding="10">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Players" Foreground="#00D7FF" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" />
                    <ListBox x:Name="PlayersListBox" 
                             Background="Transparent" 
                             BorderThickness="0"
                             Foreground="#FFFFFF"
                             MaxHeight="300"
                             ItemsSource="{Binding Players}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <Rectangle Width="10" Height="10" Fill="#00D7FF" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="11" />
                                    <TextBlock Text="{Binding Score}" Foreground="#FF006E" FontSize="11" Margin="10,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Chat Panel (Bottom Right) -->
        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20" Width="350">
            <Border BorderBrush="#00D7FF" BorderThickness="1" CornerRadius="5" Background="#1a1f3a" Padding="10">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Chat" Foreground="#FF006E" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" />
                    <ListBox x:Name="ChatListBox" 
                             Background="Transparent" 
                             BorderThickness="0"
                             MaxHeight="150"
                             ItemsSource="{Binding Messages}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="#FFFFFF" FontSize="11" TextWrapping="Wrap" Margin="0,3">
                                    <Run Foreground="#00D7FF" Text="{Binding PlayerName, StringFormat='{0}: '}" />
                                    <Run Text="{Binding Text}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBox x:Name="ChatInput" 
                             Background="#0a0e27"
                             Foreground="#FFFFFF"
                             BorderBrush="#FF006E"
                             BorderThickness="1"
                             Height="30"
                             Padding="10,5"
                             Margin="0,10,0,0"
                             KeyDown="ChatInput_KeyDown"
                             Text="Type message..." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Minimap (Top Right Corner) -->
        <Canvas x:Name="Minimap" 
                Width="150" Height="150" 
                Background="#1a1f3a"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="20"
                BorderBrush="#FF006E"
                BorderThickness="1" />

        <!-- Crosshair -->
        <Canvas x:Name="Crosshair" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Line X1="0" Y1="-15" X2="0" Y2="-25" Stroke="#FF006E" StrokeThickness="2" />
            <Line X1="15" Y1="0" X2="25" Y2="0" Stroke="#FF006E" StrokeThickness="2" />
            <Line X1="0" Y1="15" X2="0" Y2="25" Stroke="#FF006E" StrokeThickness="2" />
            <Line X1="-15" Y1="0" X2="-25" Y2="0" Stroke="#FF006E" StrokeThickness="2" />
        </Canvas>

        <!-- Settings/Pause Menu (Hidden) -->
        <Grid x:Name="PauseMenu" 
              Visibility="Hidden"
              Background="#0a0e27CC"
              ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <TextBlock Text="Game Paused" 
                           Foreground="#00D7FF" 
                           FontSize="32" 
                           FontWeight="Bold"
                           TextAlignment="Center" />
                
                <Border BorderBrush="#FF006E" BorderThickness="1" CornerRadius="5" Background="#1a1f3a" Padding="30">
                    <StackPanel Orientation="Vertical" Spacing="15">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Music" Foreground="#FFFFFF" FontSize="12" Width="100" />
                            <Slider x:Name="MusicSlider" Width="150" Minimum="0" Maximum="100" Value="70" />
                            <TextBlock x:Name="MusicValueText" Text="70%" Foreground="#FF006E" FontSize="12" Width="50" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Effects" Foreground="#FFFFFF" FontSize="12" Width="100" />
                            <Slider x:Name="EffectsSlider" Width="150" Minimum="0" Maximum="100" Value="100" />
                            <TextBlock x:Name="EffectsValueText" Text="100%" Foreground="#FF006E" FontSize="12" Width="50" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Mouse Sensitivity" Foreground="#FFFFFF" FontSize="12" Width="100" />
                            <Slider x:Name="SensitivitySlider" Width="150" Minimum="0.1" Maximum="10" Value="1" />
                            <TextBlock x:Name="SensitivityValueText" Text="1.0x" Foreground="#FF006E" FontSize="12" Width="50" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                    <Button Content="Resume (ESC)" 
                            Style="{StaticResource PrimaryButton}"
                            Click="Resume_Click" />
                    <Button Content="Settings" 
                            Style="{StaticResource SecondaryButton}"
                            Click="OpenSettings_Click" />
                    <Button Content="Leave Game" 
                            Style="{StaticResource SecondaryButton}"
                            Click="LeaveGame_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Loading Indicator -->
        <Grid x:Name="LoadingScreen" 
              Background="#0a0e27"
              ZIndex="200">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <TextBlock Text="Loading Game..." 
                           Foreground="#00D7FF" 
                           FontSize="24" 
                           TextAlignment="Center" />
                <ProgressBar Width="300" Height="20" Background="#1a1f3a" Foreground="#FF006E" IsIndeterminate="True" />
                <TextBlock x:Name="LoadingStatusText" 
                           Text="Connecting to server..." 
                           Foreground="#FFFFFF" 
                           TextAlignment="Center" 
                           FontSize="12" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
