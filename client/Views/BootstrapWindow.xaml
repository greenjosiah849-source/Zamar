<Window x:Class="ZamarPlayer.Views.BootstrapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zamar Player" Height="270" Width="480"
        WindowStyle="None"
        Background="#1a1a1a"
        WindowStartupLocation="CenterScreen"
        Foreground="White"
        Topmost="True">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="ZAMAR" FontSize="48" FontWeight="Bold" 
                       Foreground="#00D7FF" TextAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock x:Name="StatusText" Text="Initializing..." FontSize="14" 
                       Foreground="#FFFFFF" TextAlignment="Center" Margin="0,0,0,15"/>
            <ProgressBar x:Name="ProgressBar" Height="8" Width="300" 
                         Background="#333333" Foreground="#00D7FF" Margin="0,0,0,15"/>
            <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="10" 
                       Foreground="#888888" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
