<Window x:Class="ZamarPlayer.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zamar Admin Panel" Height="900" Width="1400"
        Background="#191923" Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/admin-icon.png">
    <Grid>
        <!-- Left Navigation Panel -->
        <StackPanel Width="200" Background="#0F0F13" VerticalAlignment="Stretch">
            <TextBlock Text="ZAMAR ADMIN" FontSize="16" FontWeight="Bold" Margin="15" Foreground="#00D7FF"/>
            
            <!-- Nav Buttons -->
            <Button Content="Dashboard" Tag="dashboard" Click="NavButton_Click" 
                    Style="{StaticResource NavButtonStyle}" Foreground="#00D7FF" FontWeight="Bold"/>
            <Button Content="Users" Tag="users" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>
            <Button Content="Roles" Tag="roles" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>
            <Button Content="Moderation" Tag="moderation" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>
            <Button Content="Games" Tag="games" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>
            <Button Content="Servers" Tag="servers" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>
            <Button Content="Analytics" Tag="analytics" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>
            <Button Content="Settings" Tag="settings" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}"/>
            <Button Content="Logout" Tag="logout" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}" Foreground="#FF6B6B"/>
            
            <TextBlock Text="Admin User" Margin="15,30,15,5" FontSize="12" Foreground="#888"/>
            <TextBlock x:Name="AdminNameBlock" Text="Loading..." Margin="15,0,15,15" FontSize="11" Foreground="#00D7FF"/>
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Margin="200,0,0,0">
            <!-- Dashboard Panel -->
            <ScrollViewer x:Name="DashboardPanel" Visibility="Visible">
                <StackPanel Margin="30">
                    <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <!-- Statistics Row -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <Border Background="#1A1A24" CornerRadius="8" Padding="20" Width="200" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="Total Users" Foreground="#888" FontSize="12"/>
                                <TextBlock x:Name="TotalUsersBlock" Text="0" FontSize="24" FontWeight="Bold" Foreground="#00D7FF"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1A1A24" CornerRadius="8" Padding="20" Width="200" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="Active Players" Foreground="#888" FontSize="12"/>
                                <TextBlock x:Name="ActivePlayersBlock" Text="0" FontSize="24" FontWeight="Bold" Foreground="#00FF00"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1A1A24" CornerRadius="8" Padding="20" Width="200" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="Total Games" Foreground="#888" FontSize="12"/>
                                <TextBlock x:Name="TotalGamesBlock" Text="0" FontSize="24" FontWeight="Bold" Foreground="#FFD700"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1A1A24" CornerRadius="8" Padding="20" Width="200">
                            <StackPanel>
                                <TextBlock Text="Reports" Foreground="#888" FontSize="12"/>
                                <TextBlock x:Name="ReportsBlock" Text="0" FontSize="24" FontWeight="Bold" Foreground="#FF6B6B"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Recent Activity" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <ListBox x:Name="RecentActivityList" Background="#0F0F13" Foreground="#FFF" Height="300" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Users Management Panel -->
            <ScrollViewer x:Name="UsersPanel" Visibility="Collapsed">
                <StackPanel Margin="30">
                    <TextBlock Text="User Management" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBox x:Name="UserSearchBox" Width="300" Padding="10" Background="#1A1A24" Foreground="#FFF"/>
                        <Button Content="Search" Width="100" Margin="10,0,0,0" Click="SearchUsers_Click"/>
                        <Button Content="Create User" Width="150" Margin="10,0,0,0" Click="CreateUser_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" Background="#0F0F13" Foreground="#FFF" Height="600" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                            <DataGridTextColumn Header="Joined" Binding="{Binding JoinDate}" Width="150"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Click="EditUser_Click" Width="60" Margin="5,0,0,0"/>
                                            <Button Content="Ban" Click="BanUser_Click" Width="60" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- Roles Management Panel -->
            <ScrollViewer x:Name="RolesPanel" Visibility="Collapsed">
                <StackPanel Padding="30">
                    <TextBlock Text="Role Management" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <Button Content="Create New Role" Width="200" Click="CreateRole_Click" Margin="0,0,0,15"/>

                    <ItemsControl x:Name="RolesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1A24" Padding="15" CornerRadius="8" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RoleName}" FontSize="16" FontWeight="Bold" Foreground="#00D7FF"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#999" Margin="0,5,0,10"/>
                                        <TextBlock Text="{Binding Permissions}" Foreground="#CCC" FontSize="12" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Edit" Width="70" Margin="0,0,10,0"/>
                                            <Button Content="Delete" Width="70"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Moderation Panel -->
            <ScrollViewer x:Name="ModerationPanel" Visibility="Collapsed">
                <StackPanel Padding="30">
                    <TextBlock Text="Moderation" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <ComboBox x:Name="ModFilterCombo" Width="150" Background="#1A1A24" Foreground="#FFF">
                            <ComboBoxItem>All Reports</ComboBoxItem>
                            <ComboBoxItem>Pending</ComboBoxItem>
                            <ComboBoxItem>In Progress</ComboBoxItem>
                            <ComboBoxItem>Resolved</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <DataGrid x:Name="ReportsGrid" AutoGenerateColumns="False" Background="#0F0F13" Foreground="#FFF" Height="600">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Report ID" Binding="{Binding ReportId}" Width="100"/>
                            <DataGridTextColumn Header="Reported User" Binding="{Binding ReportedUser}" Width="150"/>
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="200"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding ReportDate}" Width="150"/>
                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Review" Click="ReviewReport_Click" Width="70"/>
                                            <Button Content="Action" Click="TakeAction_Click" Width="70" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- Games Management Panel -->
            <ScrollViewer x:Name="GamesPanel" Visibility="Collapsed">
                <StackPanel Padding="30">
                    <TextBlock Text="Games Management" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBox x:Name="GameSearchBox" Width="300" Padding="10" Background="#1A1A24" Foreground="#FFF"/>
                        <Button Content="Search" Width="100" Margin="10,0,0,0" Click="SearchGames_Click"/>
                        <Button Content="Feature Game" Width="130" Margin="10,0,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="GamesGrid" AutoGenerateColumns="False" Background="#0F0F13" Foreground="#FFF" Height="600">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Game Name" Binding="{Binding GameName}" Width="200"/>
                            <DataGridTextColumn Header="Creator" Binding="{Binding Creator}" Width="150"/>
                            <DataGridTextColumn Header="Players" Binding="{Binding PlayerCount}" Width="100"/>
                            <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="View" Click="ViewGame_Click" Width="60"/>
                                            <Button Content="Ban" Click="BanGame_Click" Width="60" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- Servers Panel -->
            <ScrollViewer x:Name="ServersPanel" Visibility="Collapsed">
                <StackPanel Padding="30">
                    <TextBlock Text="Server Management" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <ItemsControl x:Name="ServersItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1A24" Padding="15" CornerRadius="8" Margin="0,0,0,15">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ServerName}" FontSize="16" FontWeight="Bold" Foreground="#00D7FF"/>
                                            <TextBlock Text="{Binding Status}" Foreground="#00FF00" Margin="20,0,0,0" FontWeight="Bold"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Region}" Foreground="#999" Margin="0,5,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="Players: " Foreground="#CCC"/>
                                            <TextBlock Text="{Binding CurrentPlayers}" Foreground="#FFD700"/>
                                            <TextBlock Text=" / " Foreground="#CCC"/>
                                            <TextBlock Text="{Binding MaxPlayers}" Foreground="#CCC"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Analytics Panel -->
            <ScrollViewer x:Name="AnalyticsPanel" Visibility="Collapsed">
                <StackPanel Padding="30">
                    <TextBlock Text="Analytics" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <Border Background="#1A1A24" Padding="15" CornerRadius="8" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Daily Active Users" FontSize="14" FontWeight="Bold" Foreground="#00D7FF"/>
                            <TextBlock x:Name="DailyActiveBlock" Text="Loading..." Foreground="#FFF" FontSize="20" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1A1A24" Padding="15" CornerRadius="8" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Games Played This Hour" FontSize="14" FontWeight="Bold" Foreground="#00D7FF"/>
                            <TextBlock x:Name="GamesPlayedBlock" Text="Loading..." Foreground="#FFF" FontSize="20" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1A1A24" Padding="15" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Average Session Duration" FontSize="14" FontWeight="Bold" Foreground="#00D7FF"/>
                            <TextBlock x:Name="AvgSessionBlock" Text="Loading..." Foreground="#FFF" FontSize="20" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
</Window>
