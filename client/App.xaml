<Application x:Class="ZamarPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/LauncherWindow.xaml">
    <Application.Resources>
        <!-- Global Color Scheme -->
        <Color x:Key="PrimaryColor">#00D7FF</Color>
        <Color x:Key="SecondaryColor">#FF006E</Color>
        <Color x:Key="DarkBg">#0a0e27</Color>
        <Color x:Key="CardBg">#1a1f3a</Color>
        <Color x:Key="DarkText">#FFFFFF</Color>
        <Color x:Key="LightText">#888888</Color>
        <Color x:Key="SuccessColor">#00FF00</Color>
        <Color x:Key="ErrorColor">#FF3333</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#00D7FF"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#FF006E"/>
        <SolidColorBrush x:Key="DarkBgBrush" Color="#0a0e27"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1a1f3a"/>

        <!-- Fonts -->
        <FontFamily x:Key="RegularFont">Segoe UI, Arial</FontFamily>

        <!-- Button Styles -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#00D7FF"/>
            <Setter Property="Foreground" Value="#0a0e27"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1a1f3a"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- TextBlock Styles -->
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#00D7FF"/>
        </Style>

        <Style x:Key="SubtitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1a1f3a"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Application.Resources>
</Application>
